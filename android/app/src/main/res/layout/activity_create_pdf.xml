<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/creator_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="#FBFAF7">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
        android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="16dp" android:paddingBottom="32dp"
        android:focusableInTouchMode="true">
        <Button android:id="@+id/creator_back" style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content" android:layout_height="48dp" android:minWidth="56dp"
            android:textAllCaps="false" android:text="@string/creator_back" android:textColor="#914234" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:text="@string/creator_eyebrow" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.12" android:textColor="#934332" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:text="@string/creator_title" android:textSize="32sp" android:textStyle="bold" android:textColor="#302D28" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp"
            android:text="@string/creator_caption" android:textSize="14sp" android:textColor="#6E6962" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:labelFor="@id/pdf_title"
            android:text="@string/creator_name_label" android:textStyle="bold" android:textSize="14sp" />
        <EditText android:id="@+id/pdf_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
            android:singleLine="true" android:inputType="textCapSentences" android:maxLength="120" android:hint="@string/creator_name_hint" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:labelFor="@id/pdf_paper"
            android:text="@string/creator_paper_label" android:textStyle="bold" android:textSize="14sp" />
        <Spinner android:id="@+id/pdf_paper" android:layout_width="match_parent" android:layout_height="48dp"
            android:entries="@array/creator_paper_sizes" android:spinnerMode="dropdown" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:labelFor="@id/pdf_text"
            android:text="@string/creator_text_label" android:textStyle="bold" android:textSize="14sp" />
        <EditText android:id="@+id/pdf_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:minLines="6" android:maxLines="12"
            android:gravity="top|start" android:inputType="textMultiLine|textCapSentences" android:maxLength="50000" android:textSize="16sp"
            android:hint="@string/creator_text_hint" android:scrollbars="vertical" />
        <TextView android:id="@+id/creator_status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:accessibilityLiveRegion="polite" android:textColor="#754735" android:textSize="14sp" />
        <Button android:id="@+id/creator_save" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="4dp"
            android:text="@string/creator_save" android:textAllCaps="false" android:textColor="#FFFFFF" android:backgroundTint="#AD4637" />
        <Button android:id="@+id/creator_open" style="?android:attr/borderlessButtonStyle" android:layout_width="match_parent" android:layout_height="48dp"
            android:text="@string/creator_open" android:textColor="#914234" android:textAllCaps="false" android:visibility="gone" />
    </LinearLayout>
</ScrollView>
