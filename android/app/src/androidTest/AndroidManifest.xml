<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Only the instrumentation APK contains this idle HOME for the disposable CI emulator. -->
    <application>
        <activity android:name="studio.ftpdf.app.test.IdleHome" android:exported="true"
            android:excludeFromRecents="true" android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
