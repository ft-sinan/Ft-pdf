{
  "id": "/",
  "name": "Ft PDF — Document Workspace",
  "short_name": "Ft PDF",
  "description": "Read, edit, and organize your PDFs, Word documents, text files, and HTML.",
  "lang": "en",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#fbfaf7",
  "theme_color": "#fbfaf7",
  "categories": ["productivity", "business"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    {
      "src": "/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "launch_handler": { "client_mode": "navigate-new" },
  "file_handlers": [
    {
      "action": "/?open-pdf",
      "accept": { "application/pdf": [".pdf"] },
      "launch_type": "multiple-clients"
    },
    {
      "action": "/",
      "accept": {
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [".docx"],
        "application/msword": [".doc"],
        "text/plain": [".txt"],
        "text/html": [".html", ".htm"]
      }
    }
  ],
  "share_target": {
    "action": "/share-inbox",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "files",
          "accept": [
            "application/pdf",
            "application/msword",
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            "text/plain",
            "text/html",
            ".pdf",
            ".doc",
            ".docx",
            ".txt",
            ".html",
            ".htm"
          ]
        }
      ]
    }
  },
  "shortcuts": [
    { "name": "All documents", "url": "/#/documents" },
    { "name": "Starred documents", "url": "/#/starred" }
  ]
}
