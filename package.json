    "image-size": "^2.1.0",
    "lucide-react": "^1.74.0",
    "mammoth": "^1.13.0",
    "multer": "^2.5.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanitize-html": "^2.18.2",
