{
  "name": "ft-pdf",
  "version": "3.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs --production",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "playwright test",
    "format": "prettier --write src server tests *.ts",
    "build:device": "tsc --noEmit && node scripts/build-device.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@libpdf/core": "^0.5.3",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "buffer": "^6.0.3",
    "docx": "^9.15.4",
    "dompurify": "^3.4.18",
    "events": "^3.3.0",
    "express": "^5.3.0",
    "fflate": "^0.8.3",
    "htmlparser2": "^10.1.0",
    "image-size": "^2.1.0",
    "lucide-react": "^1.74.0",
    "mammoth": "^1.13.0",
    "multer": "^2.5.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "pptxgenjs": "^4.0.1",
    "process": "^0.11.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "readable-stream": "^3.6.2",
    "sanitize-html": "^2.18.2",
    "tesseract.js": "6.0.1",
    "util": "^0.12.5",
    "word-extractor": "^1.0.4",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.8"
  },
  "overrides": {
    "pptxgenjs": {
      "image-size": "$image-size"
    }
  }
}
